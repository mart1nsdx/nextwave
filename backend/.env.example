# Copy to .env and fill. .env is gitignored and must never be committed.
# If a key leaks, rotate it immediately and tell the team.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

OPENAI_API_KEY=
# The Realtime beta interface was removed 2026-05-12. Verify the current model id
# before filling this in — do not copy one from a tutorial.
OPENAI_REALTIME_MODEL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where a mid-call escalation is handed off to a human.
ESCALATION_PHONE_NUMBER=

# ngrok URL Twilio calls back into. Changes on every ngrok restart.
PUBLIC_BASE_URL=
