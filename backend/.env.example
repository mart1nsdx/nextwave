# The authoritative list of keys (AGENTS.md). Every field on app/config.py:Settings
# appears here; a key that exists in one and not the other is a bug.
#
# Copy to `.env` — either here or at the repo root, both are read, and the repo root wins
# on conflict. Never commit either one.

# --- Telephony (Twilio) -------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number Volta dials from, E.164 (+52...). Its voice webhook must point at
# $PUBLIC_BASE_URL/twilio/voice or inbound calls 404 in silence.
TWILIO_PHONE_NUMBER=
# Leave true. Set false only to replay a captured webhook by hand against a local server.
VALIDATE_TWILIO_SIGNATURE=true

# --- Reasoning (OpenAI, via the Agents SDK) -----------------------------------------
OPENAI_API_KEY=
# Model ids move and most tutorials online are stale — check current ids before filling
# these in rather than copying one from memory.
OPENAI_AGENT_MODEL=
# Post-call recap and brief extraction. Falls back to OPENAI_AGENT_MODEL when empty.
OPENAI_RECAP_MODEL=
# On a phone call latency is the product: seconds of thinking read as a dropped line.
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_OUTPUT_TOKENS=300

# --- Speech (Deepgram, both directions) ---------------------------------------------
DEEPGRAM_API_KEY=
# "deepgram" | "fake". The fake providers are how sim_call and the tests run the whole
# pipeline with no network and no cost.
STT_PROVIDER=deepgram
STT_MODEL=nova-3
# "multi" allows ES/EN code-switching inside one utterance, which the judge is likely to
# do. A single code (es, en) is the alternative.
STT_LANGUAGE=multi
# The post-call evidence pass. Defaults follow the live STT settings above.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
TTS_PROVIDER=deepgram
# Aura-2 voices that switch between English and Spanish: aquila, carina, diana, javier,
# selena. aura-2-estrella-es is Mexican-accented Spanish only.
TTS_MODEL=aura-2-carina-es

# --- Turn-taking and barge-in --------------------------------------------------------
# Two different questions answered by two mechanisms — see app/voice/vad.py. Turn end
# ("did they finish?") is the vendor endpointer; barge-in ("did they start?") is local,
# because a round-trip there means talking over the counterparty for a third of a second.
VAD_ENDPOINTING_MS=100
VAD_UTTERANCE_END_MS=1000
VAD_BARGE_IN_ENABLED=true
# int16 RMS. Calibrate against a real line: too low and yard noise cuts the agent off.
VAD_BARGE_IN_RMS_THRESHOLD=900
VAD_BARGE_IN_MIN_MS=120
VAD_MIN_SILENCE_BEFORE_REPLY_MS=250

# --- Operation state (Supabase) ------------------------------------------------------
SUPABASE_URL=
# The secret (service-role) key. Server-side only — never in dashboard/.
SUPABASE_SECRET_KEY=

# --- Recap and escalation ------------------------------------------------------------
# Required for a commitment to reach COMMITTED. With these empty the recap records as
# FAILED and every commitment stalls at RECAP_FAILED — by design, not by accident.
SENDGRID_API_KEY=
RECAP_FROM_EMAIL=
RECAP_FROM_NAME=Volta
RECAP_TO_EMAIL=
# Where a warm transfer dials the human. E.164.
ESCALATION_PHONE_NUMBER=
# The public https:// tunnel Twilio can reach. Changes on every ngrok restart — re-point
# the number with `uv run python -m scripts.point_number`.
PUBLIC_BASE_URL=
