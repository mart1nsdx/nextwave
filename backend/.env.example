# Copy to .env and fill. .env is gitignored and must never be committed.
# If a key leaks, rotate it immediately and tell the team.

# --- Telephony ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VALIDATE_TWILIO_SIGNATURE=true

# --- Reasoning ---
OPENAI_API_KEY=
# Model ids move and most tutorials are stale. Verify the current fast model id
# against OpenAI's docs before filling this in — do not copy one from a tutorial.
OPENAI_AGENT_MODEL=
OPENAI_RECAP_MODEL=

# --- Speech ---
DEEPGRAM_API_KEY=
# deepgram | fake. "fake" runs the whole pipeline with no network and no cost.
STT_PROVIDER=deepgram
STT_MODEL=nova-3
# multi = ES/EN code-switching inside one utterance. Or a single code: es, en.
STT_LANGUAGE=multi
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
TTS_PROVIDER=deepgram
# Aura-2 voices that switch EN<->ES: aquila, carina, diana, javier, selena.
TTS_MODEL=aura-2-carina-es

# --- Turn-taking / VAD (see backend/app/voice/vad.py) ---
VAD_ENDPOINTING_MS=100
VAD_UTTERANCE_END_MS=1000
VAD_BARGE_IN_ENABLED=true
# int16 RMS over decoded mu-law. Calibrate on a real call: too low and line noise
# interrupts the agent, too high and a real interruption is ignored.
VAD_BARGE_IN_RMS_THRESHOLD=1800
VAD_BARGE_IN_MIN_MS=300
VAD_MIN_SILENCE_BEFORE_REPLY_MS=250

# --- Persistence ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Where a mid-call escalation is handed off to a human.
ESCALATION_PHONE_NUMBER=

# --- Written recap delivery ---
SENDGRID_API_KEY=
RECAP_FROM_EMAIL=
RECAP_FROM_NAME=Volta
RECAP_TO_EMAIL=

# ngrok URL Twilio calls back into. Changes on every ngrok restart.
PUBLIC_BASE_URL=
