# Copy to .env and fill. .env is gitignored and must never be committed.
# If a key leaks, rotate it immediately and tell the team.
#
# Scope: the call -> transcript -> Supabase -> recap -> email path.

# Twilio — inbound webhook signature validation + Media Streams.
TWILIO_AUTH_TOKEN=
# Optional. When set, the inbound call is bridged to this number so both legs have audio.
FORWARD_TO_NUMBER=
# Only set to false while testing a local tunnel. Always true otherwise.
VALIDATE_TWILIO_SIGNATURE=true

# Deepgram — streaming speech-to-text. Takes Twilio's mu-law 8 kHz directly.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# "multi" allows Spanish/English code-switching on the same call.
DEEPGRAM_LANGUAGE=multi

# OpenAI — the post-call recap + brief chat model (structured outputs).
OPENAI_API_KEY=
OPENAI_RECAP_MODEL=gpt-5.6

# SendGrid (Twilio Email) — delivers the written recap. RECAP_FROM_EMAIL must be a
# verified sender in the SendGrid account. Without both keys the recap email is disabled.
SENDGRID_API_KEY=
RECAP_FROM_EMAIL=
RECAP_FROM_NAME=Volta
# Default recipient when a call has no operation-level contact yet.
RECAP_TO_EMAIL=

# Supabase — evidence store. Service-role key is backend-only and bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public HTTPS domain Twilio calls back into (e.g. an ngrok URL). Changes on every
# ngrok restart — re-point the Twilio webhooks when it does.
PUBLIC_BASE_URL=
