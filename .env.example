# Twilio Console > Account Dashboard. Do not commit a populated .env file.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Public HTTPS address of this service. For local development use a tunnel.
PUBLIC_BASE_URL=https://your-public-domain.example

# Optional. When present, the inbound call is bridged to this number so both
# caller and agent audio can be streamed. If absent, the call remains open.
FORWARD_TO_NUMBER=

# Set to false only while testing a local tunnel. Always true in production.
VALIDATE_TWILIO_SIGNATURE=true
